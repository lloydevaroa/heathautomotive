---
import BaseLayout from '../layouts/BaseLayout.astro';

const mapsUrl =
  'https://www.google.com/maps/search/?api=1&query=19A+Aviemore+Drive+Highland+Park+Auckland';
const embedUrl =
  'https://maps.google.com/maps?q=19A+Aviemore+Drive+Highland+Park+Auckland+2010&z=16&output=embed';

// Public Turnstile site key (Cloudflare → Turnstile). Leave empty to hide the widget;
// functions/api/contact.js only checks Turnstile once TURNSTILE_SECRET_KEY is set.
const turnstileSiteKey = '';
---

<BaseLayout
  title="Contact"
  description="Call Heath Automotive on (09) 537 5694. 19A Aviemore Drive, Highland Park — behind Denny’s. Mon–Fri 8:00am–4:30pm."
  currentPath="/contact"
>
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Get in touch</p>
      <h1>Contact</h1>
      <p class="lead">Call, drop in, or send a quick message. We’re behind Denny’s on Aviemore Drive.</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="btn-row btn-row--tight" style="margin-bottom: 1.5rem;">
        <a class="btn btn-primary" href="tel:+6495375694">Call (09) 537 5694</a>
        <a class="btn btn-secondary" href={mapsUrl} rel="noopener noreferrer" target="_blank"
          >Get directions</a
        >
      </div>

      <div class="info-grid">
        <div class="info-block">
          <h3>Phone</h3>
          <p><a class="phone-lg" href="tel:+6495375694">(09) 537 5694</a></p>
          <h3 style="margin-top: 1.25rem;">Address</h3>
          <p>
            19A Aviemore Drive<br />
            Highland Park, Auckland 2010
          </p>
          <p class="card-note">Landmark: behind Denny’s on Aviemore Drive</p>
          <h3 style="margin-top: 1.25rem;">Hours</h3>
          <p>
            Mon–Fri 8:00am–4:30pm<br />
            Closed Sat–Sun
          </p>
        </div>
        <div>
          <iframe
            class="map-frame"
            title="Map — Heath Automotive, 19A Aviemore Drive"
            src={embedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <p class="muted" style="margin-top: 0.5rem;">
            <a href={mapsUrl} rel="noopener noreferrer" target="_blank">Open in Google Maps</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="max-width: 36rem;">
      <h2 id="message">Send a message</h2>
      <p class="muted">
        Leave your details and we'll get back to you. Prefer a call? Use the button above.
      </p>
      <p class="form-status form-status--ok" id="form-success" role="status" hidden>
        Thanks, your message has been sent. We'll be in touch soon.
      </p>
      <p class="form-status form-status--error" id="form-error" role="alert" hidden>
        Sorry, that didn't go through. Please try again or call us on
        <a href="tel:+6495375694">(09) 537 5694</a>.
      </p>
      <form class="contact-form" action="/api/contact" method="post">
        <input class="honeypot-field" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="ts" id="contact-ts" />
        <label>
          Name
          <input type="text" name="name" placeholder="Your name" autocomplete="name" required />
        </label>
        <label>
          Phone or email
          <input type="text" name="contact" placeholder="How we can reach you" required />
        </label>
        <label>
          Message
          <textarea name="message" rows="4" placeholder="What do you need help with?" required></textarea>
        </label>
        {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
        <button class="btn btn-primary" type="submit">Send message</button>
      </form>
      {turnstileSiteKey && (
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      )}
      <script>
        // The form works as a plain POST without JS; this adds the fill-time
        // bot check and shows the result after the redirect back here.
        const ts = document.getElementById('contact-ts') as HTMLInputElement | null;
        if (ts) ts.value = String(Date.now());
        const params = new URLSearchParams(window.location.search);
        if (params.get('sent') === 'true') document.getElementById('form-success')?.removeAttribute('hidden');
        if (params.get('error') === 'true') document.getElementById('form-error')?.removeAttribute('hidden');
      </script>
      <p class="muted" style="margin-top: 0.75rem;">
        Or call <a href="tel:+6495375694">(09) 537 5694</a> — fastest way to get fitted in.
      </p>
    </div>
  </section>
</BaseLayout>
