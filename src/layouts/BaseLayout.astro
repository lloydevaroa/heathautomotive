---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  overlayHeader?: boolean;
}

const {
  title,
  description = 'Heath Automotive — WOF, servicing and repairs in Highland Park, Auckland. Behind Denny’s on Aviemore Drive. Call (09) 537 5694.',
  currentPath = '/',
  overlayHeader = false,
} = Astro.props;

const fullTitle = title.includes('Heath Automotive')
  ? title
  : `${title} | Heath Automotive`;

const site = Astro.site ?? new URL('https://heathautomotive.co.nz');
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og-image.jpg', site).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  '@id': `${site.origin}/#business`,
  name: 'Heath Automotive',
  url: `${site.origin}/`,
  image: ogImage,
  telephone: '+64-9-537-5694',
  description:
    'WOF, servicing and repairs in Highland Park, Auckland. Local workshop behind Denny’s on Aviemore Drive.',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '19A Aviemore Drive',
    addressLocality: 'Highland Park',
    addressRegion: 'Auckland',
    postalCode: '2010',
    addressCountry: 'NZ',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '16:30',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '83',
  },
};
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1a1a" />
    {!Astro.url.pathname.startsWith('/404') && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Heath Automotive" />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Car keys on a Heath Automotive WOF job sheet" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    {Astro.url.pathname === '/' && (
      <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    )}
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LG6JQ4G9WH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-LG6JQ4G9WH', { anonymize_ip: true });

      // Calls and directions are the main conversions, so track link taps.
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href');
        if (href.indexOf('tel:') === 0) {
          gtag('event', 'phone_call_click', { link_url: href, page_path: location.pathname });
        } else if (href.indexOf('google.com/maps') !== -1) {
          gtag('event', 'directions_click', { link_url: href, page_path: location.pathname });
        }
      });

      // The contact form redirects back with ?sent=true on success.
      if (new URLSearchParams(location.search).get('sent') === 'true') {
        gtag('event', 'generate_lead', { method: 'contact_form' });
      }
    </script>
  </head>
  <body class:list={[overlayHeader && 'layout-hero-overlay']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header currentPath={currentPath} overlay={overlayHeader} />
    <main id="main" class="page-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
