---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  overlayHeader?: boolean;
}

const {
  title,
  description = 'Heath Automotive — WOF, servicing and repairs in Highland Park, Auckland. Behind Denny’s on Aviemore Drive. Call (09) 537 5694.',
  currentPath = '/',
  overlayHeader = false,
} = Astro.props;

const fullTitle = title.includes('Heath Automotive')
  ? title
  : `${title} | Heath Automotive`;
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1a1a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231a1a1a'/><text x='16' y='22' text-anchor='middle' font-size='14' font-family='system-ui' font-weight='700' fill='%23f3b93e'>HA</text></svg>" />
    <title>{fullTitle}</title>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LG6JQ4G9WH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-LG6JQ4G9WH', { anonymize_ip: true });

      // Calls and directions are the main conversions, so track link taps.
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href');
        if (href.indexOf('tel:') === 0) {
          gtag('event', 'phone_call_click', { link_url: href, page_path: location.pathname });
        } else if (href.indexOf('google.com/maps') !== -1) {
          gtag('event', 'directions_click', { link_url: href, page_path: location.pathname });
        }
      });

      // The contact form redirects back with ?sent=true on success.
      if (new URLSearchParams(location.search).get('sent') === 'true') {
        gtag('event', 'generate_lead', { method: 'contact_form' });
      }
    </script>
  </head>
  <body class:list={[overlayHeader && 'layout-hero-overlay']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header currentPath={currentPath} overlay={overlayHeader} />
    <main id="main" class="page-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
